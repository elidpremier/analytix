# Exemple de fichier de clés API pour analytix (Rapport Express)
# Renommez ce fichier en '.Renviron' ou '.env' et complétez avec vos clés.
# CE FICHIER NE DOIT JAMAIS ÊTRE COMMITÉ SUR GITHUB (déjà ignoré par .gitignore).

# Clé API Groq (Recommandé - Gratuit, 30 requêtes/min sur console.groq.com)
GROQ_API_KEY=gsk_votre_cle_groq_ici

# Clé API Mistral AI (Optionnel - sur console.mistral.ai)
MISTRAL_API_KEY=votre_cle_mistral_ici
